{
  "manifest_version": 3,
  "name": "ZAIF // ARC — FIZU Edition",
  "short_name": "ZAIF ARC",
  "version": "0.4.0",
  "description": "FIZU Edition Chrome recorder: direct local folder saves and optional offline Whisper transcription.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "downloads",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "ZAIF ARC · Click to arm / disarm this tab"
  },
  "options_page": "src/dashboard.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
